# --- Fournisseur IA ---
# "gemini" (défaut) | "openai"
AI_PROVIDER="gemini"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o"

# --- Serveur ---
PORT="3001"
HOST="0.0.0.0"
NODE_ENV="production"
# Derrière un reverse proxy (Nginx, Render, Railway…) : nombre de proxys (ex. 1)
# TRUST_PROXY="1"

# --- Données ---
# Dossier de la base JSON et du journal d'audit (créé automatiquement)
DATA_DIR="./data"
# Base de départ copiée au premier lancement si DATA_DIR est vide
# SEED_DB_FILE="./seed/verif237_db.json"

# --- CORS ---
# URL(s) du frontend autorisées à appeler cette API (séparées par des virgules)
CORS_ORIGINS="https://verif237.vercel.app"
